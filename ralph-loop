#!/usr/bin/env bash

# Ralph Loop - Interactive PRD Completion Tool
# Iteratively calls Claude to complete complex PRDs one task at a time

set -euo pipefail

# Default values
MAX_ITERATIONS=15
VERBOSE=false
DEBUG=false
RESUME=false
ANALYZE_PRD=false
PRD_FILE=""
JSON_FILE=""
PROGRESS_FILE=""

# Model selection: empty until resolved from config + CLI
TARGET_MODEL=""
ESCALATION_CAP=""
ESCALATION_THRESHOLD=""
NO_PLAN=false
# RALPH_LOOP_NO_PLAN=1 in the env is equivalent to passing --no-plan. Lets test
# environments and CI opt out of the planning stage without per-call flags.
case "${RALPH_LOOP_NO_PLAN:-}" in
    1|true|yes) NO_PLAN=true ;;
esac
CONFIG_FILE="${RALPH_LOOP_CONFIG:-${HOME}/.config/ralph-loop/config}"
DEFAULT_TARGET_MODEL="sonnet"
DEFAULT_ESCALATION_CAP="opus"
DEFAULT_ESCALATION_THRESHOLD=3

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Usage/Help function
show_help() {
    cat << 'EOF'
